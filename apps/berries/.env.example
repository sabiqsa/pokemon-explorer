# Public URL of the host app, used by the shared Navbar so links to / and other zones
# still work when this zone is opened on its own domain. Leave empty locally to use relative links.
# Example for a deploy: NEXT_PUBLIC_HOST_URL=https://pokemon-explorer-mode.vercel.app
NEXT_PUBLIC_HOST_URL=

# Upstash Redis credentials for custom entries, added by the Vercel integration on deploy.
# Leave both empty locally to save custom entries to data/*.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
