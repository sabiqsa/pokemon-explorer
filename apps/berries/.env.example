# Public URL of the host app, used by the shared Navbar so links to / and other zones
# still work when this zone is opened on its own domain. Leave empty locally to use relative links.
# Example for a deploy: NEXT_PUBLIC_HOST_URL=https://pokemon-explorer.vercel.app
NEXT_PUBLIC_HOST_URL=

# Set to "true" on deploys with a read-only filesystem (e.g. Vercel). Disables adding and
# deleting custom entries and shows a notice instead. Leave empty locally.
CUSTOM_STORAGE_READONLY=
