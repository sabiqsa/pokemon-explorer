# Where the host forwards /pokemon and /berries (rewrites in next.config.ts).
POKEMON_URL=http://localhost:3002
BERRIES_URL=http://localhost:3001

# Public URL of the host app, used by the shared Navbar. Leave empty locally to use relative links.
# Example for a deploy: NEXT_PUBLIC_HOST_URL=https://pokemon-explorer-mode.vercel.app
NEXT_PUBLIC_HOST_URL=
